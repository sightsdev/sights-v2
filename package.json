{
  "name": "sights-v2",
  "private": true,
  "version": "2.0.0-unstable",
  "type": "module",
  "scripts": {
    "sights:dev": "cd client && vite dev",
    "sights:build": "cd client && vite build",
    "sights:preview": "cd client && vite preview",
    "sights:genclient": "openapi --input http://127.0.0.1:8000/api/openapi.json --output ./client/src/lib/api --client axios --name AppClient",
    "ts:check": "cd client && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "ts:format": "cd client && prettier --write .",
    "ts:lint": "cd client && prettier --check . && eslint ."
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.36.0",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.43.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22",
    "daisyui": "^5.3.9",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.12.4",
    "globals": "^16.4.0",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-visualizer": "^6.0.5",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "@internationalized/date": "^3.8.1",
    "@lucide/svelte": "^1.43.0",
    "axios": "^1.12.2",
    "depcheck": "^1.4.7",
    "melt": "^0.41.0",
    "prism-code-editor": "^4.1.0",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "uplot": "^1.6.32"
  },
  "packageManager": "yarn@4.18.0"
}
